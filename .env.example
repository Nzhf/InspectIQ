# =============================================
# InspectIQ — Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# =============================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inspectiq
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- Ingestion Service (port 8081) ----------
INGESTION_SERVICE_PORT=8081
INGESTION_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
INGESTION_SERVICE_DB_USER=${POSTGRES_USER}
INGESTION_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}

# ---------- Analytics Service (port 8082) ----------
ANALYTICS_SERVICE_PORT=8082
ANALYTICS_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ANALYTICS_SERVICE_DB_USER=${POSTGRES_USER}
ANALYTICS_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}

# ---------- Alert Service (port 8083) ----------
ALERT_SERVICE_PORT=8083
ALERT_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ALERT_SERVICE_DB_USER=${POSTGRES_USER}
ALERT_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}

# Telegram Bot API (used by alert-service to send notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alert thresholds (configurable defaults)
ALERT_YIELD_THRESHOLD_PERCENT=95.0

# ---------- Dashboard (port 4200) ----------
# Base URLs for backend API calls from the Angular frontend
INGESTION_SERVICE_BASE_URL=http://localhost:8081
ANALYTICS_SERVICE_BASE_URL=http://localhost:8082

# ---------- Docker / Infrastructure ----------
# Used by docker-compose.yml for the PostgreSQL container
POSTGRES_DOCKER_PORT=5432
