# =============================================
# InspectIQ — Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# `docker compose up --build -d` (see the root README) reads this same file to
# run the whole local stack; empty secrets fall back to dev-only defaults.
# NEVER commit the .env file to version control.
#
# NOTE: the root .env is consumed two ways —
#   1. docker compose up --build -d — docker-compose.yml interpolates these
#      values (${VAR:-default}) to configure every container.
#   2. Running a service on the host — the service reads them as OS env vars
#      (the *_DB_URL values below target localhost for that workflow).
# =============================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inspectiq
POSTGRES_USER=
POSTGRES_PASSWORD=

# ---------- Ingestion Service (port 8081) ----------
INGESTION_SERVICE_PORT=8081
INGESTION_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
INGESTION_SERVICE_DB_USER=${POSTGRES_USER}
INGESTION_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}
# Shared secret AOI stations must send as the X-Device-Api-Key header on POST endpoints
DEVICE_API_KEY=

# Comma-separated list of browser origins allowed to call the ingestion API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- Analytics Service (port 8082) ----------
ANALYTICS_SERVICE_PORT=8082
ANALYTICS_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ANALYTICS_SERVICE_DB_USER=${POSTGRES_USER}
ANALYTICS_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}

# ---------- Alert Service (port 8083) ----------
ALERT_SERVICE_PORT=8083
ALERT_SERVICE_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ALERT_SERVICE_DB_USER=${POSTGRES_USER}
ALERT_SERVICE_DB_PASSWORD=${POSTGRES_PASSWORD}

# Rolling-window alerting (yield is measured over the most recent N inspections)
ALERT_YIELD_THRESHOLD_PERCENT=95.0   # breach when rolling yield drops below this
ALERT_LOOKBACK_INSPECTIONS=200       # rolling window size (most recent N inspections)
ALERT_MIN_INSPECTIONS=20             # minimum sample before an alert can fire
ALERT_CHECK_INTERVAL_MS=60000        # how often the monitor re-evaluates (ms)

# Telegram Bot API (used by alert-service to send notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org

# ---------- Dashboard (port 4200) ----------
# Base URLs for backend API calls from the Angular frontend
INGESTION_SERVICE_BASE_URL=http://localhost:8081
ANALYTICS_SERVICE_BASE_URL=http://localhost:8082

# ---------- Docker / Infrastructure ----------
# Used by docker-compose.yml for the PostgreSQL container
POSTGRES_DOCKER_PORT=5432

# ---------- Logging (all services) ----------
# Echo Hibernate SQL statements to the service log. Very verbose, so it is off
# by default; set to true only while debugging a query locally.
HIBERNATE_SHOW_SQL=false

# ---------- Running the whole stack ----------
# `docker compose up --build -d` reads this file and starts Postgres, the three
# backend services and the dashboard. Values set here always win over the
# compose defaults; leave POSTGRES_* / DEVICE_API_KEY blank to fall back to the
# local dev credentials. NOTE: an empty DEVICE_API_KEY leaves POST endpoints
# unprotected (a warning is logged at startup).

